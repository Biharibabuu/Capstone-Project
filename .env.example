# Copy this file to .env and add your own API keys.
# Never commit the real .env file to GitHub.

# Alpha Vantage — USD/INR exchange rate
ALPHAVANTAGE_API_KEY=replace_with_your_alpha_vantage_key

# OilPriceAPI — Brent crude benchmark
OILPRICEAPI_KEY=replace_with_your_oilpriceapi_key

# MoSPI eSankhyiki — optional Bearer token for CPI/WPI endpoints.
# Leave blank if the endpoints are accessible without a token.
MOSPI_API_TOKEN=

# Optional series configuration. Do not change base years without reconciling
# the index definition and the training data.
MOSPI_CPI_BASE_YEAR=2012
MOSPI_WPI_BASE_YEAR=2022-23
MOSPI_API_BASE_URL=https://api.mospi.gov.in

# Optional. Defaults to data/processed/market_data.sqlite3
# MARKET_DATA_DB=data/processed/market_data.sqlite3
